rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // マスター（オーナー）のメールアドレス。Firebase Authentication に登録したものに合わせる
    function isMaster() { return request.auth != null && request.auth.token.email == 'rhtcinema@gmail.com'; }
    function signedIn() { return request.auth != null; }

    // プリセット: 店舗端末は読むだけ、書けるのはマスターだけ
    match /presets/{id} {
      allow read: if signedIn();
      allow write: if isMaster();
    }
    // 店舗: 端末が変えられるのは「使用中のプリセット」「最終起動」だけ
    match /stores/{id} {
      allow read: if signedIn();
      allow create, delete: if isMaster();
      allow update: if isMaster()
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activePresetId', 'lastSeen', 'deviceVersion', 'phase', 'phaseAt']));
      match /plays/{p} { allow read: if isMaster(); allow create: if signedIn(); }
      match /days/{d} { allow read: if isMaster(); allow create, update: if signedIn(); }
      // スマホの紙幣（b83）: ログインした端末・スマホが 1 件作り、端末が state を書き戻す。消せるのはマスターだけ
      match /inserts/{i} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['ts', 'phone', 'seq', 'state'])
          && request.resource.data.ts is number && request.resource.data.phone is string && request.resource.data.state == 'new';
        allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'ackAt', 'reason']);
        allow delete: if isMaster();
      }
    }
    // 配当履歴（全店舗）: どの店舗の端末も読める。足せるのは「時刻・金額・店舗」の4項目だけ。書き換えと削除はマスターだけ
    match /feed/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ts', 'value', 'storeId', 'store'])
        && request.resource.data.ts is number && request.resource.data.value is number
        && request.resource.data.storeId is string && request.resource.data.store is string;
      allow update, delete: if isMaster();
    }
  }
}
